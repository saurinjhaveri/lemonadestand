<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Tour Guide</string>

    <key>NSMicrophoneUsageDescription</key>
    <string>Used to talk to your tour guide hands-free through your glasses.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Used to identify nearby landmarks and tailor your tour to where you are.</string>
    <key>NSCameraUsageDescription</key>
    <string>Used to capture what you are looking at so the guide can identify it.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Used to connect to your glasses for audio and capture.</string>

    <!-- Keep the Realtime voice session alive in the background. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
